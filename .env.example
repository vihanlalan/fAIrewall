# ============================================================
# fAIrewall SDK Gateway — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.
#
#   cp .env.example .env
#   nano .env          # or open in any text editor
#
# Only set the variables for the platforms you actually use.
# Adapters whose secrets are missing are silently skipped.
# ============================================================


# ------------------------------------------------------------
# GLOBAL SETTINGS  (apply to all platforms)
# ------------------------------------------------------------

# Default policy preset when a platform doesn't have its own override.
# Options: ZAPIER_SME | COPILOT_ENTERPRISE | SALESFORCE_CRM | WHATSAPP_BOT | UIPATH_RPA
FAIREWALL_PRESET=ZAPIER_SME

# API key protecting the management endpoints (/v1/inspect/*, /v1/audit/*).
# Leave blank for unauthenticated local development.
FAIREWALL_API_KEY=change-me-to-a-random-secret

# Path inside the container where the tamper-evident audit log is written.
# Mapped to ./data/audit.jsonl on the host by docker-compose.yml.
FAIREWALL_AUDIT_PATH=/app/data/audit.jsonl

# Set to "true" to run in shadow mode: decisions are logged but never block.
# Useful for dry-run testing against real traffic before going live.
FAIREWALL_SHADOW=false

# Server bind settings (usually no need to change these).
FAIREWALL_HOST=0.0.0.0
FAIREWALL_PORT=8000


# ------------------------------------------------------------
# ZAPIER AGENTS
# ------------------------------------------------------------
# Webhook URL to give Zapier:  https://YOUR_DOMAIN/v1/zapier/action
# Screen URL:                  https://YOUR_DOMAIN/v1/zapier/screen
#
# How to find your secret:
#   Zapier → Your Zap → Trigger → Webhooks by Zapier → Settings → Secret

ZAPIER_WEBHOOK_SECRET=your-zapier-hmac-secret-here

# Override the global preset just for Zapier (optional)
# ZAPIER_PRESET=ZAPIER_SME


# ------------------------------------------------------------
# MICROSOFT COPILOT STUDIO
# ------------------------------------------------------------
# Webhook URL to give Copilot Studio:  https://YOUR_DOMAIN/v1/copilot/activity
#
# How to find your Tenant ID:
#   Azure Portal → Azure Active Directory → Overview → Tenant ID

COPILOT_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Override the global preset just for Copilot (optional)
# COPILOT_PRESET=COPILOT_ENTERPRISE


# ------------------------------------------------------------
# SALESFORCE AGENTFORCE
# ------------------------------------------------------------
# Callout URL to add in Salesforce Named Credentials:
#   https://YOUR_DOMAIN/v1/salesforce/action
#
# How to find your Consumer Key:
#   Salesforce → Setup → App Manager → Your Connected App → Consumer Key

SALESFORCE_CONSUMER_KEY=your-salesforce-consumer-key-here

# Override the global preset just for Salesforce (optional)
# SALESFORCE_PRESET=SALESFORCE_CRM


# ------------------------------------------------------------
# WHATSAPP / HAPTIK
# ------------------------------------------------------------
# Webhook URL to register in Meta Developer Dashboard:
#   https://YOUR_DOMAIN/v1/whatsapp/message
#   https://YOUR_DOMAIN/v1/whatsapp/message  (GET for verification challenge)
#
# How to find your App Secret:
#   Meta for Developers → Your App → Settings → Basic → App Secret
#
# The verify token is a string YOU choose and paste into BOTH
# .env (here) and the Meta dashboard webhook settings.

META_APP_SECRET=your-meta-app-secret-here
META_VERIFY_TOKEN=my-verify-token-change-me

# Haptik-specific credentials (only needed if you use Haptik, not plain WhatsApp)
# HAPTIK_CLIENT_ID=your-haptik-client-id
# HAPTIK_API_TOKEN=your-haptik-api-token

# Override the global preset just for WhatsApp/Haptik (optional)
# HAPTIK_PRESET=WHATSAPP_BOT


# ------------------------------------------------------------
# UIPATH PLATFORM
# ------------------------------------------------------------
# Webhook URL to register in UiPath Automation Cloud:
#   Automation Cloud → Admin → Webhooks → + Add Webhook
#   URL: https://YOUR_DOMAIN/v1/uipath/job-started
#
# The secret is generated by UiPath when you create the webhook.
# Copy it here immediately — it is only shown once.

UIPATH_WEBHOOK_SECRET=your-uipath-webhook-secret-here

# Override the global preset just for UiPath (optional)
# UIPATH_PRESET=UIPATH_RPA
