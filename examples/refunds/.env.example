# Copy to examples/refunds/.env (git-ignored) and fill in.
# Leave GEMINI_API_KEY as the placeholder to run recorded scenarios only.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Keys the frontend (operator) and the finance reviewer send as "Authorization: Bearer <key>".
# They must differ. Leave them unset to get random keys printed at startup.
REFUND_OPERATOR_KEY=
REFUND_REVIEWER_KEY=
REFUND_REVIEWER_NAME=finance-reviewer

REFUND_DATA_DIR=examples/refunds/data
REFUND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
